# ─────────────────────────────────────────────────────────────
# Firebase 클라이언트 설정 (브라우저에 노출되어도 되는 값)
# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > 웹 앱 SDK 구성에서 복사
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────
# Firebase Admin (서버 전용 · 절대 커밋 금지)
# 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 으로 받은 JSON을
# base64로 인코딩해서 한 줄로 넣는다.
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
# ─────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ─────────────────────────────────────────────────────────────
# Gemini (서버 전용 · 절대 클라이언트에 노출하지 않는다)
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ─────────────────────────────────────────────────────────────
# 교사 회원가입 코드 (이 값을 아는 사람만 교사 계정을 만들 수 있다)
# ─────────────────────────────────────────────────────────────
TEACHER_SIGNUP_CODE=
