rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────
// 생기부 자율·진로 기록 도우미 — Firestore 보안 규칙
//
// 원칙
//  · 모든 쓰기는 서버(Firebase Admin SDK)를 통해서만 일어난다. Admin SDK는 이 규칙을
//    우회하므로, 클라이언트 SDK의 쓰기는 전부 막는다.
//  · 읽기는 최소 권한만 연다. 학생은 자기 자신의 자료만, 교사는 담당 학급 자료만.
//  · studentRecords(교사가 만든 생기부 특기사항)는 학생에게 읽기 권한 자체가 없다.
//    URL이나 API를 바꿔도 접근할 수 없다.
// ─────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return isSignedIn() && me().role == 'teacher';
    }

    function isStudent() {
      return isSignedIn() && me().role == 'student';
    }

    function myClassId() {
      return me().classId;
    }

    // 계정 문서: 본인 것만 읽는다.
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // 학급: 소속된 사람만 읽는다.
    match /classes/{classId} {
      allow read: if isSignedIn() && myClassId() == classId;
      allow write: if false;
    }

    // 사전 등록 명단: 교사는 담당 학급 전체, 학생은 자기 행만.
    match /studentRoster/{rosterId} {
      allow read: if (isTeacher() && resource.data.classId == myClassId())
                  || (isStudent() && resource.data.linkedUserId == request.auth.uid);
      allow write: if false;
    }

    // 활동(이벤트): 같은 학급 구성원만 읽는다.
    match /events/{eventId} {
      allow read: if isSignedIn() && resource.data.classId == myClassId();
      allow write: if false;
    }

    // 학생 소감: 학생은 본인 것만. 교사는 담당 학급 것만.
    // 다른 학생의 기록은 어떤 경우에도 읽히지 않는다.
    match /responses/{responseId} {
      allow read: if (isStudent() && resource.data.studentUid == request.auth.uid)
                  || (isTeacher() && resource.data.classId == myClassId());
      allow write: if false;
    }

    // 교사가 보완한 활동 기록: 담당 교사만. 학생은 읽기 자체가 불가.
    // (학생에게는 responses에 있는 본인 원문만 보인다)
    match /teacherNotes/{noteId} {
      allow read: if isTeacher() && resource.data.classId == myClassId();
      allow write: if false;
    }

    // 생기부 특기사항 초안/최종본: 작성한 교사만. 학생은 읽기 자체가 불가.
    match /studentRecords/{recordId} {
      allow read: if isTeacher()
                  && resource.data.teacherId == request.auth.uid
                  && resource.data.classId == myClassId();
      allow write: if false;
    }

    // 그 외 모든 경로 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
